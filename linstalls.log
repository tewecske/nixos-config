sudo add-apt-repository ppa:neovim-ppa/unstable
sudo apt-get update
sudo apt-get install neovim unzip make
mkdir ~/.ssh/
cp /mnt/c/Users/tewec/.ssh/id_rsa* ~/.ssh/
chmod go-rx ~/.ssh/*
mkdir -p ~/.config/nvim
cd ~/.config/nvim
git clone git@github.com:tewecske/kickstart.nvim.git "${XDG_CONFIG_HOME:-$HOME/.config}"/nvim
sudo apt remove golang-go golang-src golang-1.18 golang-1.18-go golang-1.18-doc golang-1.18-src
sudo apt install golang-1.22
export PATH=$PATH:/usr/local/go/bin

rm ~/.profile && ln -s ~/linstalls/bash/.profile ~/.profile
rm ~/.bashrc && ln -s ~/linstalls/bash/.bashrc ~/.bashrc
rm ~/.bash_aliases && ln -s ~/linstalls/bash/.bash_aliases ~/.bash_aliases
ln -s ~/linstalls/scripts ~/bin/scripts
ln -s ~/linstalls/tmux/.tmux.conf ~/.tmux.conf

# install scala
curl -fL "https://github.com/coursier/launchers/raw/master/cs-x86_64-pc-linux.gz" | gzip -d > cs
./cs setup
cs install mill

go install github.com/air-verse/air@latest
ln -s ~/go/bin/air ~/bin/air
go install github.com/a-h/templ/cmd/templ@latest
ln -s ~/go/bin/templ ~/bin/templ

# installs fnm (Fast Node Manager)
curl -fsSL https://fnm.vercel.app/install | bash
# activate fnm
source ~/.bashrc
# download and install Node.js
fnm use --install-if-missing 20
# verifies the right Node.js version is in the environment
node -v # should print `v20.16.0`
# verifies the right npm version is in the environment
npm -v # should print `10.8.1`

curl -sLO https://github.com/tailwindlabs/tailwindcss/releases/download/v3.4.8/tailwindcss-linux-x64
chmod +x tailwindcss-linux-x64
mv tailwindcss-linux-x64 tailwindcss
mv tailwindcss ~/bin/

curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh

sudo apt install sqlite3

sudo apt install 7zip

sudo apt-get install jq

apt install fd-find

sudo apt-get install ripgrep

sudo apt install fzf

# zoxide the better cd
curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh

# pdftotext
sudo apt-get install poppler-utils

sudo apt install golang-1.23
go install golang.org/dl/go1.23.1@latest

sudo apt install ffmpeg

# starship prompt
curl -sS https://starship.rs/install.sh | sh
